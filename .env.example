# Settings for docker compose. Copy to .env and fill in; .env is not in git.

# Password for the admin panel at /es/admin. Without it the panel is disabled.
ADMIN_PASSWORD=

# Shown to people who want to dedicate a week or a jag. Leave empty to hide.
CONTACT_EMAIL=
# WhatsApp number in international format, digits only, e.g. 5491112345678
CONTACT_WHATSAPP=
# Optional https link to a donation page (Buy Me a Coffee, Mercado Pago, PayPal…)
DONATE_URL=

# Time zone for the daily stats and for when a dedicated week starts
TZ=America/Argentina/Buenos_Aires

# Where the app listens on this machine, for your reverse proxy
BIND_ADDRESS=127.0.0.1
PORT=3000
