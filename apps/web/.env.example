# Settings for running the app with `pnpm dev`. Copy to .env.local; it is not in git.
# For docker compose, use the .env.example at the repository root instead.

# The phone reads the photo with a small local model and sends only the text,
# so reading needs no configuration or API key.

# Password for the admin panel at /es/admin or /en/admin. Without it the panel is disabled.
# ADMIN_PASSWORD=

# Shown to people who want to dedicate a week or a jag. Leave empty to hide.
# CONTACT_EMAIL=
# WhatsApp number in international format, digits only, e.g. 5491112345678
# CONTACT_WHATSAPP=
# Optional https link to a donation page
# DONATE_URL=

# Where the SQLite database and feedback photos are kept. Default: ./data
# DATA_DIR=
