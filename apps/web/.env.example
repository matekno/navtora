# Anthropic API key for the OCR. Server only.
ANTHROPIC_API_KEY=
# claude-opus-5 (default) or claude-sonnet-5, faster and cheaper with similar accuracy on clean sifrei.
OCR_MODEL=claude-opus-5
# low | medium | high. low is enough to transcribe and is the fastest.
OCR_EFFORT=low
# Lines to transcribe from the top of the column. 14 is enough to locate it; more is slower.
OCR_MAX_LINES=14
# Run without an API key: returns column OCR_ORACLE_COLUMN of the standard layout with simulated noise.
# OCR_PROVIDER=oracle
# OCR_ORACLE_COLUMN=50
# Require this password for the app and the API. Leave unset to keep the app open, e.g. locally.
# ADMIN_PASSWORD=
