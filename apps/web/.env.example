# Clave de la API de Anthropic para el OCR de la etapa 1. Sólo en el servidor.
ANTHROPIC_API_KEY=
# Modelo de visión. claude-opus-5 por defecto; claude-sonnet-5 es más rápido y barato con precisión similar en sifrei limpios.
OCR_MODEL=claude-opus-5
# Esfuerzo de razonamiento: low | medium | high. low alcanza para transcribir y es el más rápido.
OCR_EFFORT=low
# Líneas a transcribir desde arriba de la columna. Para ubicarse alcanzan 14; más líneas = más lento.
OCR_MAX_LINES=14
# Proveedor: claude (default) u oracle para probar la interfaz sin clave, con OCR_ORACLE_COLUMN.
# OCR_PROVIDER=oracle
# OCR_ORACLE_COLUMN=50
