{
  "name": "navtora",
  "private": true,
  "version": "0.1.0",
  "description": "Find your place in a Sefer Torah with the phone camera, and navigate to an aliyah",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:data": "pnpm --filter @navtora/data build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev": "pnpm --filter @navtora/web dev",
    "eval": "pnpm --filter @navtora/eval pipeline"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
