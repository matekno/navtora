{
  "name": "kore-kompanion",
  "private": true,
  "version": "0.1.0",
  "description": "Ubicaci\u00f3n y navegaci\u00f3n en un Sefer Tor\u00e1 desde el celular",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:data": "pnpm --filter @kore/data build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev": "pnpm --filter @kore/web dev",
    "eval": "pnpm --filter @kore/eval pipeline"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
